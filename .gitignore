# Build artifacts
.build/
.build_backup/
dist/

# Swift incremental-compile sidecars that escape to the repo root when an
# editor (sourcekit-lsp, VS Code Swift extension) invokes swiftc directly
# instead of going through `swift build`. Anchored to root so the
# legitimate copies under .build/ aren't double-matched.
/*.swiftdeps
/*.dia
/*.d

# Xcode
*.xcodeproj/
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/xcode/xcuserdata/
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/

# Python
__pycache__/

# Distribution (if contains signed builds)
# Distribution/
