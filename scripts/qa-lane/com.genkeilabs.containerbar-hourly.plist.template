<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ContainerBar hourly QA check (CB-105). Rendered by install.sh: __TOOLS__ and
     __HOME__ are replaced with the workspace tools folder and the user's home.
     Minute 40 keeps clear of the Sentwise hourly check at minute 10. Hours are the
     Mini's local time (Central); the script also skips outside 08:00-20:00 Central. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.genkeilabs.containerbar-hourly</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__TOOLS__/containerbar-hourly.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
__INTERVALS__
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/containerbar-qa/hourly.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/containerbar-qa/hourly.err.log</string>
</dict>
</plist>
